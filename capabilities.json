{
  "dataRoles": [
    {
      "name": "employee",
      "kind": "Grouping",
      "displayName": "Employee ID",
      "displayNameKey": "Role_employee",
      "description": "A unique ID for each person or position."
    },
    {
      "name": "manager",
      "kind": "Grouping",
      "displayName": "Manager ID",
      "displayNameKey": "Role_manager",
      "description": "The Employee ID of each person's manager. Empty for the top of the chart."
    },
    {
      "name": "name",
      "kind": "Grouping",
      "displayName": "Name",
      "displayNameKey": "Role_name",
      "description": "Shown on the card. Empty name = vacant position."
    },
    {
      "name": "dotted",
      "kind": "Grouping",
      "displayName": "Dotted-line manager ID",
      "displayNameKey": "Role_dotted",
      "description": "Optional second manager (matrix reporting). Drawn as a dashed line."
    },
    {
      "name": "title",
      "kind": "Grouping",
      "displayName": "Job title",
      "displayNameKey": "Role_title",
      "description": "Second line of the card."
    },
    {
      "name": "department",
      "kind": "Grouping",
      "displayName": "Department",
      "displayNameKey": "Role_department",
      "description": "Colours the cards and groups teams."
    },
    {
      "name": "photo",
      "kind": "Grouping",
      "displayName": "Photo",
      "displayNameKey": "Role_photo",
      "description": "A Base64 image (data:image/...) stored in your model. Web links are not loaded. Without a photo, the initials."
    },
    {
      "name": "value",
      "kind": "Measure",
      "displayName": "Value",
      "displayNameKey": "Role_value",
      "description": "Shown on each card and added up for each manager's whole team: cost, FTE, sales..."
    },
    {
      "name": "colorBy",
      "kind": "Measure",
      "displayName": "Color value",
      "displayNameKey": "Role_colorBy",
      "description": "Colours the cards on a gradient when Colors > Color by is Color value."
    },
    {
      "name": "tooltips",
      "kind": "Measure",
      "displayName": "Tooltips",
      "displayNameKey": "Role_tooltips",
      "description": "Extra values in the tooltip."
    }
  ],
