  "dataViewMappings": [
    {
      "conditions": [
        {
          "employee": {
            "max": 1
          },
          "manager": {
            "max": 1
          },
          "dotted": {
            "max": 1
          },
          "name": {
            "max": 1
          },
          "title": {
            "max": 1
          },
          "department": {
            "max": 1
          },
          "photo": {
            "max": 1
          },
          "value": {
            "max": 1
          },
          "colorBy": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "bind": {
                "to": "employee"
              }
            },
            {
              "bind": {
                "to": "manager"
              }
            },
            {
              "bind": {
                "to": "dotted"
              }
            },
            {
              "bind": {
                "to": "name"
              }
            },
            {
              "bind": {
                "to": "title"
              }
            },
            {
              "bind": {
                "to": "department"
              }
            },
            {
              "bind": {
                "to": "photo"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "value"
              }
            },
            {
              "bind": {
                "to": "colorBy"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
